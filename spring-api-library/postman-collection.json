{
	"info": {
		"_postman_id": "c2a8a1e3-a1b2-4d3c-8a9a-9e8f0a1b2c3d",
		"name": "Spring API Library - Secured",
		"description": "A collection for testing the secured Spring Boot Library API. Start by running the 'Login' request.",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"item": [
		{
			"name": "Authentication",
			"item": [
				{
					"name": "Login",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"// Automatically save the JWT token to a collection variable",
									"if (pm.response.code === 200) {",
									"    pm.collectionVariables.set(\"jwt_token\", pm.response.json().token);",
									"    console.log('JWT Token saved.');",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"username\": \"admin\",\n    \"password\": \"password\"\n}",
							"options": {
								"raw": {
									"language": "json"
								}
							}
						},
						"url": {
							"raw": "{{baseUrl}}/api/auth/login",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"api",
								"auth",
								"login"
							]
						},
						"description": "Authenticates the user and retrieves a JWT. The token is automatically saved as a collection variable."
					},
					"response": []
				}
			]
		},
		{
			"name": "Books",
			"item": [
				{
					"name": "Get Books (Paginated)",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/api/books/page?page=0&size=5",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"api",
								"books",
								"page"
							],
							"query": [
								{
									"key": "page",
									"value": "0"
								},
								{
									"key": "size",
									"value": "5"
								}
							]
						}
					},
					"response": []
				},
				{
					"name": "Create New Book",
					"request": {
						"method": "POST",
						"header": [],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"title\": \"New Book from Postman\",\n    \"author\": \"Test Author\",\n    \"isbn\": \"9876543210123\",\n    \"price\": 19.99,\n    \"status\": \"AVAILABLE\"\n}",
							"options": {
								"raw": {
									"language": "json"
								}
							}
						},
						"url": {
							"raw": "{{baseUrl}}/api/books",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"api",
								"books"
							]
						}
					},
					"response": []
				}
			]
		}
	],
	"auth": {
		"type": "bearer",
		"bearer": [
			{
				"key": "token",
				"value": "{{jwt_token}}",
				"type": "string"
			}
		]
	},
	"event": [
		{
			"listen": "prerequest",
			"script": {
				"exec": [
					"// Automatically handle CSRF token for state-changing requests",
					"const xsrfCookie = pm.cookies.get('XSRF-TOKEN');",
					"if (xsrfCookie) {",
					"    pm.request.headers.add({",
					"        key: 'X-XSRF-TOKEN',",
					"        value: xsrfCookie",
					"    });",
					"}"
				],
				"type": "text/javascript"
			}
		}
	],
	"variable": [
		{
			"key": "baseUrl",
			"value": "http://localhost:8080",
			"type": "string"
		},
		{
			"key": "jwt_token",
			"value": "",
			"type": "string"
		}
	]
}
